# Google Gemini API Configuration
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Model Configuration - Google only
# Available Models: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash, gemini-1.0-pro
GOOGLE_MODEL=gemini-2.0-flash

# Remote Embedding API Configuration
REMOTE_EMBEDDING_URL=https://api.confusedelectrons.xyz/embed-query-w-sentence-transformers/
REMOTE_EMBEDDING_API_KEY=your_embedding_api_key_here

# Port Configuration
BACKEND_PORT=5000
FRONTEND_PORT=3001

# Instructions:
# 1. Get a Google Gemini API key from: https://makersuite.google.com/app/apikey
# 2. Replace 'your_google_gemini_api_key_here' with your actual API key
# 3. If using a different embedding service, update the REMOTE_EMBEDDING_URL and API key
# 4. Save this file as '.env' in the project root directory
