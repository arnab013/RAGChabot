/**
 * Utility functions for chart data transformation
 */

/**
 * Convert snake_case or camelCase to Title Case
 * @param {string} str - String to convert
 * @returns {string} - Title case string
 */
export function toTitleCase(str) {
  if (!str) return '';
  
  return str
    .split(/[_\s-]/)
    .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
    .join(' ');
}

/**
 * Transform backend chart data for multi-line charts
 * Handles time-series data where we need to group by categories
 * @param {Array} data - Raw chart data
 * @param {Object} chartConfig - Chart configuration
 * @returns {Object} - Transformed data for Recharts
 */
export function transformDataForMultiLineChart(data, chartConfig) {
  if (!data || !Array.isArray(data) || data.length === 0) {
    return { data: [], xAxisField: 'x', lineFields: [] };
  }

  const { xKey = 'category', yKeys = [] } = chartConfig;
  
  // For our backend data structure, we already have the right format
  // Just ensure numeric values are properly converted
  const transformedData = data.map(item => {
    const newItem = { ...item };
    yKeys.forEach(key => {
      if (newItem[key] !== undefined && !isNaN(Number(newItem[key]))) {
        newItem[key] = Number(newItem[key]);
      }
    });
    return newItem;
  });

  return {
    data: transformedData,
    xAxisField: xKey,
    lineFields: yKeys
  };
}

/**
 * Process chart data based on chart type and data size
 * Limits data points for better visualization
 * @param {Array} data - Chart data
 * @param {string} chartType - Type of chart
 * @param {number} maxPoints - Maximum data points to show
 * @returns {Array} - Processed data
 */
export function processChartData(data, chartType, maxPoints = 20) {
  if (!data || !Array.isArray(data)) return [];
  
  if ((chartType === 'bar' || chartType === 'pie') && data.length > maxPoints) {
    return data.slice(0, maxPoints);
  }
  
  return data;
}

/**
 * Get modern dark theme color palette for charts
 * @param {number} count - Number of colors needed
 * @returns {Array} - Array of color strings
 */
export function getChartColors(count = 8) {
  const colors = [
    '#06b6d4', // cyan-500
    '#3b82f6', // blue-500  
    '#8b5cf6', // violet-500
    '#10b981', // emerald-500
    '#f59e0b', // amber-500
    '#ef4444', // red-500
    '#ec4899', // pink-500
    '#84cc16', // lime-500
    '#6366f1', // indigo-500
    '#14b8a6', // teal-500
    '#f97316', // orange-500
    '#a855f7', // purple-500
    '#22d3ee', // cyan-400
    '#60a5fa', // blue-400
    '#a78bfa'  // violet-400
  ];
  
  return Array.from({ length: count }, (_, i) => colors[i % colors.length]);
}
