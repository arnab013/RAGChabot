import React from 'react';
import {
  BarChart,
  Bar,
  LineChart,
  Line,
  AreaChart,
  Area,
  PieChart,
  Pie,
  Cell,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  Legend,
  ResponsiveContainer,
  Treemap,
  Label,
} from 'recharts';
import { toTitleCase, processChartData, getChartColors } from '../utils/chartUtils';

/**
 * Enhanced Dynamic Chart Component for Patent Search System
 * Handles chart data from the backend API and renders appropriate visualizations
 * Based on modern chart component patterns with improved styling and functionality
 */
const PatentChart = ({ chartData }) => {
  console.log('PatentChart received chartData:', chartData);
    if (!chartData || !chartData.type || !chartData.data) {
    console.warn('Invalid chart data received:', chartData);
    return (
      <div className="flex items-center justify-center h-64 text-gray-400 bg-gray-800/50 rounded-xl border-2 border-dashed border-gray-600 backdrop-blur-sm">
        <div className="text-center">
          <svg className="mx-auto h-8 w-8 text-gray-500 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          <p className="text-sm text-gray-400">No chart data available</p>
        </div>
      </div>
    );
  }

  const { type, title, data } = chartData;
  
  // Debug the chart data structure
  console.log('PatentChart rendering with:', { 
    type, 
    title, 
    dataType: data ? typeof data : 'undefined',
    dataIsArray: Array.isArray(data),
    dataHasLabels: data && data.labels,
    dataHasDatasets: data && data.datasets
  });
  // Transform backend chart data to Recharts format
  const transformDataForRecharts = (backendData) => {
    console.log('Transforming chart data:', backendData);
    
    if (!backendData) {
      console.warn('No backend data to transform');
      return [];
    }
    
    // Handle different data structures that might come from the backend
    
    // Case 1: If data is already an array of objects ready for Recharts
    if (Array.isArray(backendData) && backendData.length > 0 && typeof backendData[0] === 'object') {
      console.log('Data is already in array format');
      return backendData;
    }
    
    // Case 2: Treemap data format
    if (type === 'treemap') {
      // Treemap data is already in the right format
      if (backendData.datasets && backendData.datasets[0] && backendData.datasets[0].data) {
        console.log('Processing treemap data');
        return backendData.datasets[0].data;
      }
      
      // Alternative format sometimes used
      if (Array.isArray(backendData)) {
        console.log('Processing alternative treemap data');
        return backendData;
      }
    }
    
    // Case 3: Standard Chart.js format with labels and datasets
    if (backendData.labels && backendData.datasets) {
      console.log('Processing standard Chart.js format');
      const labels = backendData.labels || [];
      const datasets = backendData.datasets || [];
      
      if (datasets.length === 0) return [];
      
      return labels.map((label, index) => {
        const dataPoint = { category: label };
        datasets.forEach((dataset, datasetIndex) => {
          const key = dataset.label || `value${datasetIndex}`;
          const value = dataset.data?.[index];
          dataPoint[key] = isNaN(Number(value)) ? value : Number(value);
        });
        return dataPoint;
      });
    }
    
    // Case 4: Simple key-value object
    if (typeof backendData === 'object' && !Array.isArray(backendData) && !backendData.labels && !backendData.datasets) {
      console.log('Processing simple key-value object');
      return Object.entries(backendData).map(([key, value]) => ({
        category: key,
        value: typeof value === 'number' ? value : Number(value) || 0
      }));
    }
    
    console.warn('Could not determine chart data format:', backendData);
    return [];
  };

  const rawChartData = transformDataForRecharts(data);
  const chartDataFormatted = processChartData(rawChartData, type);
  
  // Get chart configuration
  const datasets = data.datasets || [];
  const yKeys = datasets.map(dataset => dataset.label || 'value');
  const xKey = 'category';
  const colors = getChartColors(yKeys.length);
  // Enhanced custom tooltip with dark theme
  const CustomTooltip = ({ active, payload, label }) => {
    if (active && payload && payload.length) {
      return (
        <div className="bg-gray-800 p-4 border border-cyan-400/30 rounded-xl shadow-2xl backdrop-blur-md max-w-xs">
          <p className="font-semibold text-white mb-3 text-sm border-b border-gray-700 pb-2">{toTitleCase(String(label))}</p>
          {payload.map((entry, index) => (
            <div key={index} className="flex items-center justify-between text-sm mb-1">
              <span className="flex items-center">
                <div 
                  className="w-3 h-3 rounded-full mr-3 shadow-sm" 
                  style={{ backgroundColor: entry.color, boxShadow: `0 0 6px ${entry.color}30` }}
                />
                <span className="text-gray-300">{toTitleCase(entry.name)}:</span>
              </span>
              <span className="font-medium ml-3 text-white">
                {typeof entry.value === 'number' ? entry.value.toLocaleString() : entry.value}
              </span>
            </div>
          ))}
        </div>
      );
    }
    return null;
  };

  // Enhanced treemap content with better text handling
  const TreemapContent = ({ root, depth, x, y, width, height, index, payload }) => {
    const showText = depth === 1 && width > 60 && height > 30;
    const fontSize = Math.min(12, Math.max(8, Math.min(width / 8, height / 4)));
    
    return (
      <g>
        <rect
          x={x}
          y={y}
          width={width}
          height={height}
          style={{
            fill: depth < 2 ? payload.backgroundColor || colors[index % colors.length] : 'none',
            stroke: '#fff',
            strokeWidth: 2 / (depth + 1),
            strokeOpacity: 1 / (depth + 1),
          }}
        />
        {showText && (
          <text
            x={x + width / 2}
            y={y + height / 2}
            textAnchor="middle"
            fill="#fff"
            fontSize={fontSize}
            fontWeight="600"
            style={{ textShadow: '1px 1px 2px rgba(0,0,0,0.5)' }}
          >
            {payload.name?.length > 15 ? `${payload.name.substring(0, 15)}...` : payload.name}
          </text>
        )}
      </g>
    );
  };

  // Main chart rendering function
  const renderChart = () => {    const commonProps = {
      margin: { top: 30, right: 40, left: 80, bottom: 100 }
    };

    switch (type) {      case 'line':
        return (
          <LineChart data={chartDataFormatted} {...commonProps}>
            <CartesianGrid strokeDasharray="3 3" stroke="#374151" />
            <XAxis 
              dataKey={xKey}
              tick={{ fontSize: 12, fill: '#d1d5db' }}
              stroke="#6b7280"
              angle={-45}
              textAnchor="end"
              height={80}
            >
              <Label 
                value={toTitleCase(xKey)} 
                offset={-5} 
                position="insideBottom"
                style={{ fill: '#d1d5db', fontSize: '12px' }}
              />
            </XAxis>
            <YAxis 
              tick={{ fontSize: 12, fill: '#d1d5db' }}
              stroke="#6b7280"
            >
              <Label 
                value={toTitleCase(yKeys[0] || 'Value')} 
                angle={-90} 
                position="insideLeft"
                style={{ fill: '#d1d5db', fontSize: '12px' }}
              />
            </YAxis>
            <Tooltip content={<CustomTooltip />} />
            <Legend 
              wrapperStyle={{ color: '#d1d5db' }}
            />
            {yKeys.map((key, index) => (
              <Line
                key={key}
                type="monotone"
                dataKey={key}
                stroke={colors[index]}
                strokeWidth={3}
                fill="transparent"
                dot={{ r: 5, strokeWidth: 2, fill: colors[index] }}
                activeDot={{ r: 7, strokeWidth: 2, fill: colors[index] }}
              />
            ))}
          </LineChart>
        );      case 'area':
        return (
          <AreaChart data={chartDataFormatted} {...commonProps}>
            <CartesianGrid strokeDasharray="3 3" stroke="#374151" />
            <XAxis 
              dataKey={xKey}
              tick={{ fontSize: 12, fill: '#d1d5db' }}
              stroke="#6b7280"
              angle={-45}
              textAnchor="end"
              height={80}
            >
              <Label 
                value={toTitleCase(xKey)} 
                offset={-5} 
                position="insideBottom"
                style={{ fill: '#d1d5db', fontSize: '12px' }}
              />
            </XAxis>
            <YAxis 
              tick={{ fontSize: 12, fill: '#d1d5db' }}
              stroke="#6b7280"
            >
              <Label 
                value={toTitleCase(yKeys[0] || 'Value')} 
                angle={-90} 
                position="insideLeft"
                style={{ fill: '#d1d5db', fontSize: '12px' }}
              />
            </YAxis>
            <Tooltip content={<CustomTooltip />} />
            <Legend 
              wrapperStyle={{ color: '#d1d5db' }}
            />
            {yKeys.map((key, index) => (
              <Area
                key={key}
                type="monotone"
                dataKey={key}
                stroke={colors[index]}
                fill={colors[index]}
                strokeWidth={3}
                fillOpacity={0.3}
              />
            ))}
          </AreaChart>
        );      case 'bar':
        return (
          <BarChart data={chartDataFormatted} {...commonProps}>
            <CartesianGrid strokeDasharray="3 3" stroke="#374151" />
            <XAxis 
              dataKey={xKey}
              tick={{ fontSize: 12, fill: '#d1d5db' }}
              stroke="#6b7280"
              angle={-45}
              textAnchor="end"
              height={80}
            >
              <Label 
                value={toTitleCase(xKey)} 
                offset={-5} 
                position="insideBottom"
                style={{ fill: '#d1d5db', fontSize: '12px' }}
              />
            </XAxis>
            <YAxis 
              tick={{ fontSize: 12, fill: '#d1d5db' }}
              stroke="#6b7280"
            >
              <Label 
                value={toTitleCase(yKeys[0] || 'Value')} 
                angle={-90} 
                position="insideLeft"
                style={{ fill: '#d1d5db', fontSize: '12px' }}
              />
            </YAxis>
            <Tooltip content={<CustomTooltip />} />
            <Legend 
              wrapperStyle={{ color: '#d1d5db' }}
            />
            {yKeys.map((key, index) => (
              <Bar
                key={key}
                dataKey={key}
                fill={colors[index]}
                radius={[6, 6, 0, 0]}
              />
            ))}
          </BarChart>
        );      case 'stacked_bar':
        return (
          <BarChart data={chartDataFormatted} {...commonProps}>
            <CartesianGrid strokeDasharray="3 3" stroke="#374151" />
            <XAxis 
              dataKey={xKey}
              tick={{ fontSize: 12, fill: '#d1d5db' }}
              stroke="#6b7280"
              angle={-45}
              textAnchor="end"
              height={80}
            >
              <Label 
                value={toTitleCase(xKey)} 
                offset={-5} 
                position="insideBottom"
                style={{ fill: '#d1d5db', fontSize: '12px' }}
              />
            </XAxis>
            <YAxis 
              tick={{ fontSize: 12, fill: '#d1d5db' }}
              stroke="#6b7280"
            >
              <Label 
                value="Count" 
                angle={-90} 
                position="insideLeft"
                style={{ fill: '#d1d5db', fontSize: '12px' }}
              />
            </YAxis>
            <Tooltip content={<CustomTooltip />} />
            <Legend 
              wrapperStyle={{ color: '#d1d5db' }}
            />
            {yKeys.map((key, index) => (
              <Bar
                key={key}
                dataKey={key}
                stackId="stack"
                fill={colors[index]}
              />
            ))}
          </BarChart>
        );      case 'pie':
        return (
          <PieChart {...commonProps}>
            <Pie
              data={chartDataFormatted}
              cx="50%"
              cy="50%"
              outerRadius={140}
              innerRadius={0}
              dataKey={yKeys[0] || 'value'}
              nameKey={xKey}
              label={({ name, percent }) => `${name}: ${(percent * 100).toFixed(1)}%`}
              labelLine={false}
              fontSize={12}
              fill="#d1d5db"
            >
              {chartDataFormatted.map((entry, index) => (
                <Cell 
                  key={`cell-${index}`} 
                  fill={colors[index]}
                />
              ))}
            </Pie>
            <Tooltip content={<CustomTooltip />} />
            <Legend 
              wrapperStyle={{ color: '#d1d5db' }}
            />
          </PieChart>
        );      case 'treemap':
        return (
          <Treemap
            data={chartDataFormatted}
            dataKey="value"
            ratio={4/3}
            stroke="#374151"
            content={<TreemapContent />}
          >
            <Tooltip content={<CustomTooltip />} />
          </Treemap>
        );

      default:
        return (
          <div className="flex items-center justify-center h-64 text-gray-400">
            <div className="text-center">
              <svg className="mx-auto h-8 w-8 text-gray-500 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p className="text-sm text-gray-400">Unsupported chart type: {type}</p>
            </div>
          </div>
        );
    }
  };

  return (
    <div className="w-full bg-gradient-to-br from-gray-800/90 to-gray-900/90 rounded-xl shadow-2xl border border-cyan-400/20 p-6 my-6 backdrop-blur-sm">
      {/* Chart Header */}
      <div className="mb-6">
        <h3 className="text-xl font-semibold text-white text-center mb-2">{title}</h3>
        <div className="h-0.5 bg-gradient-to-r from-transparent via-cyan-400 to-transparent mx-auto w-32" />
      </div>

      {/* Chart Container */}
      <div className="w-full h-[500px]">
        <ResponsiveContainer width="100%" height="100%">
          {renderChart()}
        </ResponsiveContainer>
      </div>

      {/* Chart Footer Info */}
      <div className="mt-6 flex items-center justify-between">
        <span className="text-sm text-gray-300 bg-gray-700/50 px-4 py-2 rounded-full border border-gray-600">
          {toTitleCase(type)} Chart
        </span>
        <span className="text-sm text-gray-400">
          {chartDataFormatted.length} data point{chartDataFormatted.length !== 1 ? 's' : ''}
        </span>
      </div>
    </div>
  );
};

export default PatentChart;
